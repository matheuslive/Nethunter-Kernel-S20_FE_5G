#!/system/bin/sh
# wmon -- coloca a interface WiFi em modo monitor e abre o airodump-ng.
#
# Roda SOB DEMANDA, como root (sudo/su), no proprio aparelho (Termux).
#
# Escolha da interface:
#   PADRAO -> wlan1 (dongle USB externo: ath9k_htc/AR9271, RTL8812AU, mt7601u...).
#             Caminho ESTAVEL do NetHunter: monitor + injection, hopping livre. O
#             companion carrega o ath9k_htc no boot, entao o AR9271 vira wlan1
#             sozinho ao plugar; outros chips: rode 'usbwifi' antes.
#   wlan0  -> radio interno QCA6390, SO com '-i wlan0' ou '-t' (NAO e mais
#             fallback automatico). Entra em monitor mas o firmware nao deixa
#             fixar canal (iw set channel -> timeout -110): captura nao rola
#             (muro de firmware). A v4.8.2 faz isso falhar limpo, sem travar.
#
# Uso:
#   wmon                 usa o dongle wlan1 (default; NAO cai no interno)
#   wmon -c 6            trava no canal 6
#   wmon -i wlan1        forca a interface
#   wmon -i wlan1 -c 36  interface + canal
#   wmon -i wlan0 -c 6   forca o radio interno (nao captura -- muro de firmware)
#   wmon -- --band a     tudo apos '--' vai direto pro airodump-ng
#   wmon -l              lista as interfaces WiFi vistas e sai
#   wmon -t              TESTE do monitor interno wlan0 (valida o fix v4.8.2)
#   wmon -t -c 36        idem, no canal 36 (default 6)
#   wmon -h              esta ajuda
#
# No interno o monitor e GLOBAL: derruba o WiFi/STA enquanto captura (por isso
# rode LOCAL, nunca por SSH sobre WiFi). Ao sair, o wmon volta sozinho: dongle
# -> managed; interno -> con_mode=0 + religa o WiFi.

die() { echo "wmon: $*" >&2; exit 1; }

# A ajuda tem que funcionar antes de qualquer checagem.
case "${1:-}" in
  -h|--help) awk 'NR>1{if(/^#/){sub(/^# ?/,"");print}else exit}' "$0"; exit 0 ;;
esac

# --- resolucao de binarios ---------------------------------------------------
# sudo/su costuma zerar o PATH, e iw/airodump-ng podem estar no prefixo do
# Termux (ou no chroot do Kali). Procura no PATH e depois nos locais conhecidos.
TERMUX=/data/data/com.termux/files/usr
resolve() {
  p=$(command -v "$1" 2>/dev/null) && { echo "$p"; return 0; }
  for d in "$TERMUX/bin" /usr/bin /system/bin /vendor/bin; do
    [ -x "$d/$1" ] && { echo "$d/$1"; return 0; }
  done
  return 1
}

IP=$(resolve ip)   || die "'ip' nao encontrado."
IW=$(resolve iw)   || die "'iw' nao encontrado (pkg install iw no Termux)."
AIRO=$(resolve airodump-ng) \
  || die "airodump-ng nao encontrado (instale o aircrack-ng no Termux/chroot)."

# airodump/iw do Termux precisam achar as libs deles.
case "$AIRO" in "$TERMUX"*) NEED_TLIB=1 ;; esac
case "$IW"   in "$TERMUX"*) NEED_TLIB=1 ;; esac
[ -n "${NEED_TLIB:-}" ] && export LD_LIBRARY_PATH="$TERMUX/lib:${LD_LIBRARY_PATH:-}"

# timeout opcional: envolve passos que PODEM pendurar no driver interno.
# 't 15 cmd...' roda 'timeout 15 cmd' se houver timeout; senao 'cmd' direto.
TMO=$(resolve timeout 2>/dev/null || true)
t() { if [ -n "$TMO" ]; then "$TMO" "$@"; else shift; "$@"; fi; }

is_wifi() {  # $1 = nome da interface; true se ela existe e tem phy80211
  [ -e "/sys/class/net/$1/phy80211" ]
}

if [ "${1:-}" = "-l" ] || [ "${1:-}" = "--list" ]; then
  echo "wmon: interfaces WiFi:"
  found=0
  for n in /sys/class/net/*; do
    i=${n##*/}
    is_wifi "$i" || continue
    found=1
    st=$(cat "$n/operstate" 2>/dev/null)
    ty=$($IW dev "$i" info 2>/dev/null | awk '/type/{print $2; exit}')
    echo "    $i  (operstate=$st, type=${ty:-?})"
  done
  [ "$found" = 1 ] || echo "    (nenhuma)"
  exit 0
fi

# --- root --------------------------------------------------------------------
[ "$(id -u)" = 0 ] || die "precisa ser root (rode com sudo/su)."

# --- argumentos --------------------------------------------------------------
IFACE=""; CHAN=""; EXTRA=""; TEST=""
while [ $# -gt 0 ]; do
  case "$1" in
    -i|--iface)   IFACE=${2:?wmon: -i exige o nome da interface}; shift 2 ;;
    -c|--channel) CHAN=${2:?wmon: -c exige o numero do canal};    shift 2 ;;
    -t|--test)    TEST=1; shift ;;
    --) shift; EXTRA="$*"; break ;;
    -*) die "opcao desconhecida: $1 (veja 'wmon -h')" ;;
    *)  die "argumento inesperado: $1 (canal e '-c $1'; veja 'wmon -h')" ;;
  esac
done

# --- modo teste (-t): valida o fix de monitor interno da v4.8.2 e sai --------
# Roda de proposito a sequencia que ANTES travava o driver (con_mode=4 com
# wlan0 partindo de DOWN + 'ip link up' + 'iw set channel'), com timeout nos
# passos arriscados. Com o fix, o pior caso vira erro recuperavel -- se o script
# chegar ao fim SEM exigir 'reboot -f', a Fase 0-B ja provou seu valor.
run_selftest() {
  CONMODE=/sys/module/wlan/parameters/con_mode
  ERRF=/data/local/tmp/wmon_test.err
  CH=${CHAN:-6}
  is_wifi wlan0    || die "wlan0 (radio interno) nao existe."
  [ -w "$CONMODE" ] || die "$CONMODE ausente: kernel sem o wlan built-in?"

  echo "wmon: === TESTE monitor interno QCA6390 (fix v4.8.2), canal $CH ==="
  echo "wmon: isto derruba seu WiFi/STA -- rode LOCAL, nunca por SSH sobre WiFi."
  echo "wmon: se voltar SEM exigir 'reboot -f', a Fase 0-B pegou."

  restore() {
    echo "wmon: restaurando (con_mode=0 + WiFi)..."
    echo 0 > "$CONMODE" 2>/dev/null
    svc wifi disable 2>/dev/null; svc wifi enable 2>/dev/null
    echo "wmon: se o WiFi nao voltar, reconecte pelas Configuracoes."
  }
  trap restore EXIT INT TERM

  echo "wmon: [1/4] con_mode=4 a partir de wlan0 DOWN..."
  $IP link set wlan0 down 2>/dev/null
  echo 4 > "$CONMODE" || die "escrita em con_mode falhou."
  t 15 $IP link set wlan0 up || echo "wmon:   aviso: 'ip link up' rc=$?"
  ty=$($IW dev wlan0 info 2>/dev/null | awk '/type/{print $2; exit}')
  echo "wmon:   wlan0 type=${ty:-?} (esperado: monitor)"

  echo "wmon: [2/4] iw set channel $CH (o passo que travava)..."
  if t 15 $IW dev wlan0 set channel "$CH" 2>"$ERRF"; then
    echo "wmon:   OK: canal fixado sem travar"; setok=1
  else
    rc=$?; setok=0
    echo "wmon:   FALHOU rc=$rc"
    err=$(head -1 "$ERRF" 2>/dev/null | cut -c1-76)
    [ -n "$err" ] && echo "wmon:   $err"
    [ "$rc" = 124 ] && echo "wmon:   rc=124=timeout; veja 'dmesg | tail'."
  fi
  rm -f "$ERRF"

  n=-1
  if [ "$setok" = 1 ]; then
    echo "wmon: [3/4] contando frames por 8s (rx_packets)..."
    RXP=/sys/class/net/wlan0/statistics/rx_packets
    b=$(cat "$RXP" 2>/dev/null || echo 0)
    sleep 8
    a=$(cat "$RXP" 2>/dev/null || echo 0)
    n=$((a - b))
    echo "wmon:   frames RX em 8s: $n"
  else
    echo "wmon: [3/4] pulei a captura (canal nao fixou)"
  fi

  echo "wmon: [4/4] veredito:"
  if [ "$setok" = 1 ] && [ "$n" -gt 0 ]; then
    echo "wmon:   >>> FUNCIONOU: captura no canal $CH sem travar."
  elif [ "$setok" = 1 ]; then
    echo "wmon:   >>> canal OK, 0 frames: tente o canal do seu AP (-c N)."
  else
    echo "wmon:   >>> nao fixou canal: muro de firmware provavel -> use dongle."
  fi
  exit 0
}

[ -n "$TEST" ] && run_selftest

# --- autodeteccao da interface ----------------------------------------------
if [ -z "$IFACE" ]; then
  if is_wifi wlan1; then
    IFACE=wlan1
  else
    die "wlan1 (dongle USB) nao encontrado. Plugue o dongle -- o companion ja
       carrega o ath9k_htc no boot, entao o AR9271 vira wlan1 sozinho; outros
       chips: rode 'usbwifi'. Para o radio interno wlan0 (NAO captura, muro de
       firmware) use de proposito: wmon -i wlan0 -c <canal>."
  fi
fi
is_wifi "$IFACE" || die "interface '$IFACE' nao existe ou nao e WiFi."

# =============================================================================
# Caminho A: radio interno QCA6390 (wlan0) via con_mode
# =============================================================================
CONMODE=/sys/module/wlan/parameters/con_mode
if [ "$IFACE" = "wlan0" ]; then
  [ -w "$CONMODE" ] || die "$CONMODE ausente: kernel sem o wlan built-in?"

  # Sem canal fixo o airodump faria hopping -> 'iw set channel' em loop.
  [ -n "$CHAN" ] || die "no wlan0 interno o canal e OBRIGATORIO (ex.: wmon -c 6).
       Melhor: use um dongle USB (wlan1)."

  echo "wmon: ! wlan0 INTERNO (QCA6390). Confirmado em teste (wmon -t): o"
  echo "wmon: ! firmware NAO deixa fixar canal em monitor (iw set channel ->"
  echo "wmon: ! timeout -110), entao a captura no interno em geral NAO rola."
  echo "wmon: ! A v4.8.2 faz isso FALHAR em vez de travar o aparelho."
  echo "wmon: ! Prefira o dongle USB. Monitor GLOBAL derruba o WiFi agora."

  cleanup_internal() {
    echo ""
    echo "wmon: saindo do monitor (con_mode=0) e religando o WiFi..."
    echo 0 > "$CONMODE" 2>/dev/null
    svc wifi disable 2>/dev/null; svc wifi enable 2>/dev/null
    echo "wmon: pronto. Se o WiFi nao voltar, reconecte pelas Configuracoes."
  }
  trap cleanup_internal EXIT INT TERM

  # Partir de wlan0 DOWN e o que evita o vazamento de refcount de netdev
  # ('unregister_netdevice: waiting for wlan0 to become free') que trava a
  # troca de con_mode quando a STA esta ativa. Foi assim que o 'wmon -t' nao
  # travou; o antigo "exija wlan0 up" era justamente o gatilho do leak.
  echo "wmon: [1/3] wlan0 DOWN + con_mode=4 (teardown limpo)..."
  $IP link set wlan0 down 2>/dev/null
  echo 4 > "$CONMODE" || die "escrita em con_mode falhou."
  t 15 $IP link set wlan0 up || echo "wmon: aviso: 'ip link up' rc=$?"

  echo "wmon: [2/3] iw set channel $CHAN..."
  if t 15 $IW dev wlan0 set channel "$CHAN" 2>/dev/null; then
    echo "wmon: [3/3] canal fixado. airodump-ng no wlan0 canal $CHAN (sem hop)"
    # shellcheck disable=SC2086
    "$AIRO" -c "$CHAN" $EXTRA wlan0
  else
    echo "wmon: iw set channel falhou (esperado: timeout -110 = muro de"
    echo "wmon: firmware da QCA6390). Nao rodo o airodump. USE UM DONGLE USB."
  fi
  exit 0
fi

# =============================================================================
# Caminho B: dongle USB (wlan1 ou outro) via nl80211 padrao
# =============================================================================
cleanup_dongle() {
  echo ""
  echo "wmon: restaurando $IFACE para managed..."
  $IP link set "$IFACE" down 2>/dev/null
  $IW dev "$IFACE" set type managed 2>/dev/null
  $IP link set "$IFACE" up 2>/dev/null
  echo "wmon: pronto."
}
trap cleanup_dongle EXIT INT TERM

echo "wmon: colocando $IFACE em monitor..."
$IP link set "$IFACE" down                    || die "nao consegui derrubar $IFACE"
# 'set monitor control' e preferido; alguns drivers so aceitam 'set type monitor'.
$IW dev "$IFACE" set monitor control 2>/dev/null \
  || $IW dev "$IFACE" set type monitor        || die "nao entrou em monitor"
$IP link set "$IFACE" up                       || die "nao consegui subir $IFACE"

if [ -n "$CHAN" ]; then
  $IW dev "$IFACE" set channel "$CHAN" 2>/dev/null \
    || echo "wmon: aviso: nao fixou o canal $CHAN (segue no hopping)"
  echo "wmon: airodump-ng no $IFACE, canal $CHAN"
  # shellcheck disable=SC2086
  "$AIRO" -c "$CHAN" $EXTRA "$IFACE"
else
  echo "wmon: airodump-ng no $IFACE (hopping em todos os canais)"
  # shellcheck disable=SC2086
  "$AIRO" $EXTRA "$IFACE"
fi
