#!/system/bin/sh
# usbwifi -- carrega o driver do dongle WiFi USB plugado.
#
# Os drivers de dongle (ath9k_htc, 88XXAU, rt2800usb, mt7601u, ...) deixaram de
# ser built-in no kernel: como .ko eles so ocupam RAM quando ha dongle plugado
# (~7 MB a menos de kernel residente). Em troca, precisam ser carregados.
#
# Uso:
#   usbwifi              detecta o dongle plugado e carrega o driver dele
#   usbwifi <modulo>     carrega um modulo pelo nome (ex.: usbwifi 88XXAU)
#   usbwifi -l           lista os modulos disponiveis
#   usbwifi -r <modulo>  descarrega

die() { echo "usbwifi: $*" >&2; exit 1; }

# O -h vem antes de procurar os .ko: ajuda tem que funcionar mesmo sem eles.
case "${1:-}" in
  -h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

# Onde estao os .ko. Ficam FORA da arvore system/ do modulo (em
# $MODID/modules/), de proposito: injetar .ko em /system/lib/modules forcava o
# magic mount a clonar /system/lib inteiro (~760 bind-mounts dos .so irmaos,
# replicados por namespace -> ~34 MB de slab). Fora de system/ eles nao sao
# montados e o modprobe -d os le direto do /data/adb. modules_update/ e onde o
# Magisk poe a instalacao pendente, modules/ a ativa; as duas entradas em
# system/lib/modules sao fallback para pacotes antigos com o layout antigo.
MODID=nethunter_companion_r8q
for d in "/data/adb/modules_update/$MODID/modules" \
         "/data/adb/modules/$MODID/modules" \
         "/data/adb/modules_update/$MODID/system/lib/modules" \
         "/data/adb/modules/$MODID/system/lib/modules" \
         /system/lib/modules; do
	[ -f "$d/modules.alias" ] || continue
	MODDIR=$d
	break
done
[ -n "${MODDIR:-}" ] || die "nao achei os .ko (o modulo Magisk esta instalado?)"

case "${1:-}" in
  -l|--list)
    ls "$MODDIR" | grep '\.ko$' | sed 's/\.ko$//' | sort
    exit 0
    ;;
  -r|--remove)
    [ -n "${2:-}" ] || die "-r exige o nome do modulo"
    modprobe -d "$MODDIR" -r "$2" || die "nao consegui descarregar $2"
    echo "usbwifi: $2 descarregado"
    exit 0
    ;;
esac

load() {
	modprobe -d "$MODDIR" "$1" || die "modprobe de $1 falhou (veja dmesg)"
	echo "usbwifi: $1 carregado"
	echo "usbwifi: interfaces agora: $(ls /sys/class/net | tr '\n' ' ')"
	echo "usbwifi: se o driver reclamar de firmware faltando no dmesg, o .bin"
	echo "         precisa estar em /system/etc/firmware ou /vendor/firmware."
}

# Modulo dado na linha de comando.
if [ -n "${1:-}" ]; then
	load "$1"
	exit 0
fi

# Sem argumento: procura um dongle plugado e casa o VID:PID contra o
# modules.alias. Os aliases USB sempre comecam por "usb:vXXXXpXXXX", entao
# basta comparar esse prefixo (em maiusculas, como o depmod gera).
for dev in /sys/bus/usb/devices/*; do
	[ -f "$dev/idVendor" ] || continue
	vid=$(cat "$dev/idVendor" 2>/dev/null | tr 'a-f' 'A-F')
	pid=$(cat "$dev/idProduct" 2>/dev/null | tr 'a-f' 'A-F')
	[ -n "$vid" ] && [ -n "$pid" ] || continue

	mod=$(awk -v k="usb:v${vid}p${pid}" \
	          '$1=="alias" && index($2,k)==1 {print $3; exit}' \
	          "$MODDIR/modules.alias")
	[ -n "$mod" ] || continue

	echo "usbwifi: $vid:$pid ($(cat "$dev/product" 2>/dev/null)) -> $mod"
	load "$mod"
	exit 0
done

echo "usbwifi: nenhum dongle conhecido plugado." >&2
echo "         dongles vistos pelo USB:" >&2
for dev in /sys/bus/usb/devices/*; do
	[ -f "$dev/idVendor" ] || continue
	echo "           $(cat "$dev/idVendor"):$(cat "$dev/idProduct")" \
	     "$(cat "$dev/product" 2>/dev/null)" >&2
done
echo "         'usbwifi -l' lista os drivers disponiveis para carregar na mao." >&2
exit 1
