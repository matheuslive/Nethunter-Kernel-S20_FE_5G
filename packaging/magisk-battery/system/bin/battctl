#!/system/bin/sh
# battctl -- le e escreve os parametros de carga do sec_battery (r8q).
#
# Os numeros de carga do S20 FE moram no device tree, e o DTB nao chega ao
# device pelo AnyKernel (boot v2 usa a secao dtb stock). O que resta e o sysfs
# do driver: /sys/class/power_supply/battery/. Parte dele existe no kernel
# stock (batt_full_capacity, batt_slate_mode, store_mode); os batt_tune_* so
# aparecem com CONFIG_ENG_BATTERY_CONCEPT=y, que o kernel Nethunter r8q v4.3+
# habilita.
#
# Uso:
#   battctl status              estado da bateria + parametros ativos
#   battctl show                conteudo do arquivo de configuracao
#   battctl apply               reaplica tudo que esta no arquivo
#   battctl set <chave> <val>   grava no arquivo e aplica agora
#   battctl get <chave>         le o valor atual no kernel
#   battctl limit <pct|off>     atalho para FULL_CAPACITY (para de carregar em pct)
#   battctl charge on|off       slate mode: corta a carga mantendo o link USB
#   battctl raw <attr> [val]    le/escreve um atributo qualquer do sysfs
#   battctl reset               desfaz o que e reversivel sem reboot
#   battctl watchdog            reaplica FULL_CAPACITY em loop (uso do service.sh)
#
# Alem dos parametros do driver, o arquivo tem chaves que configuram o proprio
# modulo (SIOP_LOCK, BOOT_DELAY_SEC, WATCHDOG_SEC) -- "battctl show" lista as
# duas familias.

PSY=/sys/class/power_supply/battery
CONF=/data/adb/nethunter-battery.conf
LOG=/data/adb/nethunter-battery.log

die() { echo "battctl: $*" >&2; exit 1; }

# O -h vem antes da checagem do sysfs: ajuda tem que funcionar em qualquer lugar.
case "${1:-}" in
	-h|--help|help) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

[ -d "$PSY" ] || die "$PSY nao existe -- este device nao usa o sec_battery?"

# --- tabela de parametros ----------------------------------------------------
#
# chave|atributo sysfs|min|max|unidade|descricao
#
# Os limites sao os que o proprio driver valida em sec_battery_sysfs.c: escrever
# fora da faixa e ignorado em silencio pelo kernel, entao barramos aqui para o
# erro aparecer. Temperatura e em decimos de grau (500 = 50.0 C).
#
# As linhas abaixo passam de 85 colunas por serem um registro por linha; a
# SAIDA respeita o limite (o "show" quebra a descricao em linha propria).
PARAMS='
FULL_CAPACITY|batt_full_capacity|0|100|%|para de carregar nesta carga (0 = desliga; recarrega em -2%)
FLOAT_VOLTAGE|batt_tune_float_voltage|4001|4400|mV|tensao de fim de carga (4400 = stock, 4100 poupa a celula)
INPUT_CURRENT|batt_tune_input_charge_current|0|4000|mA|limite de corrente de ENTRADA (todos os cabos menos USB)
FAST_CURRENT|batt_tune_fast_charge_current|0|4000|mA|corrente de carga da bateria (idem)
TERM_CURRENT_1ST|batt_tune_ui_term_cur_1st|1|999|mA|corrente de corte do 1o "cheio"
TERM_CURRENT_2ND|batt_tune_ui_term_cur_2nd|1|999|mA|corrente de corte do 2o "cheio"
CHG_TEMP_HIGH|batt_tune_chg_temp_high|-200|999|0.1C|temperatura do charger que dispara o throttle
CHG_TEMP_REC|batt_tune_chg_temp_rec|-200|999|0.1C|temperatura de recuperacao do throttle
CHG_LIMIT_CURRENT|batt_tune_chg_limit_cur|1|2999|mA|corrente de entrada durante o throttle termico
TEMP_HIGH_NORMAL|batt_tune_temp_high_normal|-200|999|0.1C|temperatura da bateria que bloqueia a carga
TEMP_HIGH_REC_NORMAL|batt_tune_temp_high_rec_normal|-200|999|0.1C|temperatura que libera a carga de volta
TEMP_LOW_NORMAL|batt_tune_temp_low_normal|-200|999|0.1C|temperatura baixa que bloqueia a carga
TEMP_LOW_REC_NORMAL|batt_tune_temp_low_rec_normal|-200|999|0.1C|temperatura baixa que libera a carga
STORE_MODE|store_mode|0|1|-|modo loja: mantem a carga entre 70 e 80% (SO LIGA; desligar exige reboot)
SIOP_LEVEL|siop_level|0|100|-|throttle global de corrente; 100 = sem throttle (ver SIOP_LOCK)
WC_ENABLE|wc_enable|0|1|-|carga sem fio (0 = recusa o carregador indutivo)
WC_TX_STOP_CAPACITY|wc_tx_stop_capacity|0|100|%|power share para de alimentar nesta carga
WPC_TEMP_HIGH|batt_tune_wpc_temp_high|-200|999|0.1C|temperatura que throttla a carga sem fio
WPC_TEMP_REC|batt_tune_wpc_temp_high_rec|-200|999|0.1C|temperatura que a libera de volta
SKIP_SWELLING|batt_swelling_control|0|1|-|1 DESLIGA o swelling mode (a protecao de temperatura)
SAFETY_TIMER|safety_timer_set|0|1|-|timer de seguranca: corta a carga se demorar demais
WDT_KICK_DISABLE|batt_wdt_control|0|1|-|1 para de alimentar o watchdog do charger
BATTERY_CYCLE|battery_cycle|0|9999|ciclos|ciclos da celula; define o degrau de age forecast
'

# Chaves que configuram o MODULO, nao o driver: nao tem atributo em sysfs.
# Sem elas aqui, "battctl set BOOT_DELAY_SEC 30" morria como chave desconhecida.
#
# chave|min|max|unidade|descricao
BEHAVIOR='
SIOP_LOCK|0|1|-|tranca o siop_level em 0444 depois de aplicar SIOP_LEVEL
BOOT_DELAY_SEC|0|600|s|espera depois do boot_completed antes de aplicar
WATCHDOG_SEC|0|86400|s|reaplica FULL_CAPACITY a cada N segundos (0 = desliga)
'

behavior_field() {  # behavior_field <chave> <min|max|unit|desc>
	echo "$BEHAVIOR" | while IFS='|' read -r k lo hi u d; do
		[ "$k" = "$1" ] || continue
		case "$2" in
			min) echo "$lo" ;; max) echo "$hi" ;;
			unit) echo "$u" ;; desc) echo "$d" ;;
		esac
	done
}

param_field() {  # param_field <chave> <n-do-campo>
	echo "$PARAMS" | while IFS='|' read -r k a lo hi u d; do
		[ "$k" = "$1" ] || continue
		case "$2" in
			attr) echo "$a" ;; min) echo "$lo" ;; max) echo "$hi" ;;
			unit) echo "$u" ;; desc) echo "$d" ;;
		esac
	done
}

keys() {
	echo "$PARAMS" | while IFS='|' read -r k _; do [ -n "$k" ] && echo "$k"; done
}

# --- helpers de sysfs --------------------------------------------------------

has_eng() { [ -e "$PSY/batt_tune_float_voltage" ]; }

rd() { [ -r "$PSY/$1" ] && cat "$PSY/$1" 2>/dev/null; }

# wr <attr> <valor>
#
# O veredito NAO pode sair do codigo de retorno do write: sec_bat_store_attrs()
# comeca com "int ret = -EINVAL" e NENHUM handler batt_tune_* faz "ret = count"
# (batt_full_capacity, store_mode e batt_slate_mode fazem -- por isso so os
# tune reclamavam). O valor e aplicado e o write(2) devolve erro assim mesmo.
#
# Entao: releitura manda. Se ela nao confirmar, ainda ha o caso legitimo do
# atributo que nao ecoa o que recebeu -- batt_tune_float_voltage repassa o
# valor ao charger via VOLTAGE_MAX, mas o show le battery->pdata, que nao muda.
# Como a faixa ja foi validada contra a do driver antes de chegar aqui, um
# batt_tune_* nessa situacao conta como aplicado.
#
# Deixa em WR_CONFIRMED se a releitura confirmou (1) ou nao (0), para quem
# chama poder ser honesto na mensagem.
wr() {
	WR_CONFIRMED=0
	[ -e "$PSY/$1" ] || { echo "battctl: $1 nao existe neste kernel" >&2; return 1; }

	# Com SIOP_LOCK o siop_level fica em 0444 e nem o root escreve (testado).
	# Destranca so durante a escrita; siop_lock_apply() retranca depois.
	relock=0
	if [ "$1" = siop_level ] && ! attr_writable "$1"; then
		chmod 0664 "$PSY/$1" 2>/dev/null && relock=1
	fi

	echo "$2" > "$PSY/$1" 2>/dev/null
	rc=$?
	[ "$relock" = 1 ] && chmod a=r "$PSY/$1" 2>/dev/null

	if [ "$(rd "$1")" = "$2" ]; then
		WR_CONFIRMED=1
		return 0
	fi
	[ "$rc" = 0 ] && return 0
	case "$1" in batt_tune_*) return 0 ;; esac

	echo "battctl: falhou escrever $2 em $1 (root?)" >&2
	return 1
}

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG"; }

# "-w" nao serve: para o root ele diz sim mesmo em arquivo 0444. Vale o modo.
attr_writable() {
	case "$(stat -c %a "$PSY/$1" 2>/dev/null)" in
		[2367]*) return 0 ;;
		*) return 1 ;;
	esac
}

# Tranca (ou destranca) o siop_level conforme SIOP_LOCK. Trancado, o framework
# nao consegue baixar o nivel para throttlar a carga -- era o que o antigo
# /data/adb/service.d/siop.sh fazia, agora absorvido aqui.
siop_lock_apply() {
	[ -e "$PSY/siop_level" ] || return 0
	case "$(conf_get SIOP_LOCK)" in
		1) chmod a=r "$PSY/siop_level" 2>/dev/null ;;
		0) chmod 0664 "$PSY/siop_level" 2>/dev/null ;;
	esac
}

# --- configuracao ------------------------------------------------------------

conf_get() {  # conf_get <chave> -- valor no arquivo, vazio se ausente/comentado
	[ -f "$CONF" ] || return 0
	sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\([^#[:space:]]*\).*/\1/p" \
		"$CONF" | tail -1
}

# Tudo que o battctl grava vai para uma secao no FIM do arquivo. O corpo acima
# dela fica intocado: e o template comentado, que serve de documentacao das
# chaves e das faixas. Como a secao e sempre a ultima coisa do arquivo, gravar
# = remover a chave de onde estiver e acrescentar no fim.
CONF_MARK='# === Configurado (o battctl escreve daqui para baixo) ==='

# Junta TODA linha ativa (esteja ela onde estiver) na secao do fim, uma por
# chave, e deixa o corpo so com os comentarios. Chave repetida: vence a ultima,
# na posicao da primeira. Linha comentada nunca e tocada -- e a documentacao.
conf_normalize() {
	[ -f "$CONF" ] || : > "$CONF"
	awk -v mark="$CONF_MARK" '
		/^[[:space:]]*[A-Za-z_][A-Za-z_0-9]*[[:space:]]*=/ {
			eq = index($0, "=")
			k = substr($0, 1, eq - 1); gsub(/[[:space:]]/, "", k)
			v = substr($0, eq + 1)
			h = index(v, "#"); if (h) v = substr(v, 1, h - 1)
			gsub(/^[[:space:]]+/, "", v); gsub(/[[:space:]]+$/, "", v)
			if (!(k in val)) order[++n] = k
			val[k] = v
			next
		}
		$0 == mark { next }
		{ body[++b] = $0 }
		END {
			# corpo sem as linhas em branco do fim, para nao acumular uma a
			# cada normalizacao
			while (b > 0 && body[b] ~ /^[[:space:]]*$/) b--
			for (i = 1; i <= b; i++) print body[i]
			print ""
			print mark
			for (i = 1; i <= n; i++) print order[i] "=" val[order[i]]
		}
	' "$CONF" > "$CONF.tmp" && mv -f "$CONF.tmp" "$CONF"
}

conf_set() {  # conf_set <chave> <valor>
	[ -f "$CONF" ] || : > "$CONF"
	# Acrescenta e normaliza: como a ultima ocorrencia vence, isso atualiza a
	# chave se ela ja existia, em qualquer lugar do arquivo.
	printf '%s=%s\n' "$1" "$2" >> "$CONF"
	conf_normalize
}

validate() {  # validate <chave> <valor>
	lo=$(param_field "$1" min); hi=$(param_field "$1" max)
	if [ -z "$lo" ]; then
		lo=$(behavior_field "$1" min); hi=$(behavior_field "$1" max)
	fi
	[ -n "$lo" ] || die "chave desconhecida: $1 (use 'battctl show' para a lista)"
	case "$2" in
		''|*[!0-9-]*) die "valor invalido para $1: '$2' (esperado um inteiro)" ;;
	esac
	[ "$2" -ge "$lo" ] && [ "$2" -le "$hi" ] || \
		die "$1 fora da faixa aceita pelo driver: $lo..$hi"
}

apply_key() {  # apply_key <chave> <valor> -- silencioso no modo boot
	attr=$(param_field "$1" attr)
	[ -n "$attr" ] || return 1
	if [ ! -e "$PSY/$attr" ]; then
		[ "$BOOT" = 1 ] || {
			echo "battctl: $1 ignorado -- $attr nao existe" >&2
			echo "         (kernel sem CONFIG_ENG_BATTERY_CONCEPT?)" >&2
		}
		[ "$BOOT" = 1 ] && log "SKIP $1=$2 ($attr ausente)"
		return 1
	fi
	if wr "$attr" "$2"; then
		# Mudar os ciclos so nao basta: quem recalcula o degrau (e com ele a
		# float voltage) e o sec_bat_aging_check(), disparado por este attr.
		[ "$1" = BATTERY_CYCLE ] && [ -e "$PSY/battery_cycle_test" ] && \
			echo 1 > "$PSY/battery_cycle_test" 2>/dev/null
		[ "$BOOT" = 1 ] && log "SET $1=$2"
		return 0
	fi
	[ "$BOOT" = 1 ] && log "FAIL $1=$2"
	return 1
}

cmd_apply() {
	[ -f "$CONF" ] || die "$CONF nao existe"
	# Arruma o arquivo antes de ler: e o que migra para a secao um conf antigo
	# (ou editado a mao no corpo) sem exigir um "set". Idempotente.
	conf_normalize
	n=0
	for k in $(keys); do
		v=$(conf_get "$k")
		[ -n "$v" ] || continue
		# STORE_MODE=0 nao faz nada no driver (o handler so trata x!=0);
		# nao vale nem tentar, para nao poluir o log.
		[ "$k" = STORE_MODE ] && [ "$v" = 0 ] && continue
		if apply_key "$k" "$v"; then
			[ "$BOOT" = 1 ] || echo "  $k = $v $(param_field "$k" unit)"
			n=$((n + 1))
		fi
	done
	siop_lock_apply
	[ "$BOOT" = 1 ] || echo "battctl: $n parametro(s) aplicado(s)"
}

# --- comandos ----------------------------------------------------------------

cmd_status() {
	cap=$(rd capacity); vol=$(rd voltage_now); cur=$(rd current_now)
	tmp=$(rd temp);     sts=$(rd status);      hlt=$(rd health)
	echo "Bateria"
	echo "  carga        : ${cap:-?} %"
	echo "  tensao       : $(awk "BEGIN{printf \"%.3f\", ${vol:-0}/1000000}") V"
	# O sec_battery reporta corrente em mA (SEC_BATTERY_CURRENT_MA), nao em uA
	# como manda o padrao do power_supply; a tensao segue em uV.
	echo "  corrente     : ${cur:-?} mA  (negativo = descarregando)"
	echo "  temperatura  : $(awk "BEGIN{printf \"%.1f\", ${tmp:-0}/10}") C"
	echo "  status       : ${sts:-?} / ${hlt:-?}"
	echo "  modelo       : $(rd batt_type 2>/dev/null || echo '?')"
	echo "  online       : $(rd online) (0 = sem cabo)"
	echo
	echo "Parametros"
	if has_eng; then
		echo "  [ENG_BATTERY_CONCEPT presente -- batt_tune_* disponiveis]"
	else
		echo "  [sem ENG_BATTERY_CONCEPT -- so batt_full_capacity/slate/store]"
	fi
	# Tudo daqui para baixo cabe em 85 colunas: 2+21+1+6+1+7+2+11+1+4+2 = 58.
	# O sed no fim do grupo tira o padding a direita da ultima coluna.
	{
	printf '  %-21s %6s %7s  %-11s %-4s\n' PARAMETRO ATIVO CONFIG POSSIVEIS UNID
	# Uma passada so pelo PARAMS: chamar param_field por campo custaria um
	# subshell por celula da tabela.
	echo "$PARAMS" | while IFS='|' read -r k a lo hi u d; do
		[ -n "$k" ] || continue
		[ -e "$PSY/$a" ] || continue
		val=$(rd "$a")
		cfg=$(conf_get "$k"); [ -n "$cfg" ] || cfg="-"
		# Faixa continua de inteiros, ou enumeracao quando sao dois valores.
		if [ "$lo" = 0 ] && [ "$hi" = 1 ]; then rng="0|1"; else rng="$lo..$hi"; fi

		flag=""
		if [ "$k" = SIOP_LEVEL ] && ! attr_writable "$a"; then
			flag=" L"
		elif [ "$k" = FLOAT_VOLTAGE ]; then
			# O show le battery->pdata->chg_float_voltage, que o store nao
			# atualiza (ele repassa o valor ao charger via VOLTAGE_MAX): aqui
			# sai o numero do device tree mesmo com override em vigor. Quem
			# confirma o valor real e o dmesg do charger.
			flag=" *"
		elif [ "$cfg" != "-" ] && [ "$cfg" != "$val" ]; then
			# Config gravada que nao bateu com o kernel: ou nao foi aplicada
			# ainda (mexeram no arquivo na mao), ou algo sobrescreveu depois.
			flag=" !"
		fi
		printf '  %-21s %6s %7s  %-11s %-4s%s\n' "$k" "$val" "$cfg" "$rng" "$u" "$flag"
	done
	printf '  %-21s %6s %7s  %-11s %-4s\n' \
		slate_mode "$(rd batt_slate_mode)" - "0|1|2" -
	} | sed 's/[[:space:]]*$//'
	echo
	echo "  ATIVO = no kernel agora;  CONFIG = no arquivo ('-' = nao configurado)"
	echo "  * leitura nao reflete override (veja o dmesg)   ! CONFIG != ATIVO"
	echo "  L = atributo trancado em 0444 (SIOP_LOCK)"
	echo "  slate: 0=normal  1=carga cortada  2=smart"
	echo
	echo "Modulo"
	echo "$BEHAVIOR" | while IFS='|' read -r k lo hi u d; do
		[ -n "$k" ] || continue
		cfg=$(conf_get "$k"); [ -n "$cfg" ] || cfg="-"
		printf '  %-21s %6s %7s  %-11s %-4s\n' "$k" "" "$cfg" "$lo..$hi" "$u"
	done | sed 's/[[:space:]]*$//'
	echo "  arquivo: $CONF"
}

cmd_show() {
	echo "Chaves conhecidas:"
	# Descricao em linha propria: junto com o nome ela passaria de 85 colunas.
	echo "$PARAMS" | while IFS='|' read -r k a lo hi u d; do
		[ -n "$k" ] || continue
		printf '  %-21s %-11s %s\n' "$k" "$lo..$hi" "$u"
		printf '      %s\n' "$d"
	done
	echo
	echo "Chaves do modulo (nao vao para o sysfs):"
	echo "$BEHAVIOR" | while IFS='|' read -r k lo hi u d; do
		[ -n "$k" ] || continue
		printf '  %-21s %-11s %s\n' "$k" "$lo..$hi" "$u"
		printf '      %s\n' "$d"
	done
	echo
	if [ -f "$CONF" ]; then
		echo "--- configuracao ---"
		echo "($CONF)"
		cat "$CONF"
	else
		echo "(ainda nao existe: $CONF)"
	fi
}

cmd_watchdog() {
	iv=$(conf_get WATCHDOG_SEC)
	case "$iv" in ''|0|*[!0-9]*) exit 0 ;; esac
	want=$(conf_get FULL_CAPACITY)
	[ -n "$want" ] && [ "$want" != 0 ] || exit 0
	log "watchdog ligado (FULL_CAPACITY=$want, a cada ${iv}s)"
	while :; do
		sleep "$iv"
		now=$(rd batt_full_capacity)
		[ "$now" = "$want" ] && continue
		# O app "Proteger bateria" da One UI escreve neste mesmo atributo; se
		# ele (ou qualquer outro) mudar o valor, devolvemos o nosso.
		wr batt_full_capacity "$want" && log "watchdog: $now -> $want"
	done
}

case "${1:-status}" in
	status)  cmd_status ;;
	show)    cmd_show ;;
	apply)   [ "${2:-}" = "--boot" ] && BOOT=1; cmd_apply ;;
	watchdog) cmd_watchdog ;;

	set)
		[ $# -eq 3 ] || die "uso: battctl set <chave> <valor>"
		validate "$2" "$3"
		if [ -n "$(behavior_field "$2" min)" ]; then
			# Configura o modulo, nao o driver: so grava.
			conf_set "$2" "$3"
			siop_lock_apply
			echo "battctl: $2 = $3 (gravado; vale a partir de agora)"
		else
			apply_key "$2" "$3" || die "nao apliquei $2"
			conf_set "$2" "$3"
			[ "$2" = SIOP_LEVEL ] && siop_lock_apply
			echo "battctl: $2 = $3 $(param_field "$2" unit) (aplicado e gravado)"
			[ "${WR_CONFIRMED:-0}" = 1 ] || \
				echo "  o driver nao ecoa este atributo: o status nao confirma, veja o dmesg"
		fi
		;;

	get)
		[ $# -eq 2 ] || die "uso: battctl get <chave>"
		attr=$(param_field "$2" attr)
		if [ -z "$attr" ]; then
			[ -n "$(behavior_field "$2" min)" ] || die "chave desconhecida: $2"
			conf_get "$2"; exit 0
		fi
		rd "$attr" || die "$attr nao existe neste kernel"
		;;

	limit)
		[ $# -eq 2 ] || die "uso: battctl limit <pct|off>"
		v=$2; [ "$v" = off ] && v=0
		validate FULL_CAPACITY "$v"
		[ "$v" != 0 ] && [ "$v" -lt 50 ] && \
			die "limite abaixo de 50% nao faz sentido no uso diario"
		apply_key FULL_CAPACITY "$v" && conf_set FULL_CAPACITY "$v"
		if [ "$v" = 0 ]; then
			echo "battctl: limite de carga desligado"
		else
			echo "battctl: para de carregar em $v%, recarrega em $((v - 2))%"
		fi
		;;

	charge)
		case "${2:-}" in
			off) wr batt_slate_mode 1 &&
			     echo "battctl: carga cortada (slate) -- USB segue conectado" ;;
			on)  wr batt_slate_mode 0 && echo "battctl: carga liberada" ;;
			*)   die "uso: battctl charge on|off" ;;
		esac
		;;

	raw)
		[ $# -ge 2 ] || die "uso: battctl raw <attr> [valor]"
		if [ $# -eq 2 ]; then
			rd "$2" || die "$2 nao existe ou nao e legivel"
		else
			wr "$2" "$3" && echo "battctl: $2 <- $3"
		fi
		;;

	reset)
		wr batt_full_capacity 0 && conf_set FULL_CAPACITY 0
		wr batt_slate_mode 0
		echo "battctl: limite de carga e slate mode desligados."
		echo "  float voltage, correntes e temperaturas so voltam ao padrao do"
		echo "  device tree depois de um reboot. Antes dele, tire as chaves da"
		echo "  secao 'Configurado' -- senao o service.sh reaplica no boot:"
		echo "  $CONF"
		;;

	# -h ja foi tratado la em cima, antes da checagem do sysfs.
	*) die "comando desconhecido: $1 (battctl -h)" ;;
esac
