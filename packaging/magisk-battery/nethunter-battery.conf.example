# nethunter-battery.conf -- parametros de carga aplicados no boot pelo
# modulo Magisk "NetHunter Battery (r8q)".
#
# Formato: CHAVE=valor, uma por linha. Linha comentada = parametro nao tocado
# (o kernel fica com o valor do device tree). Depois de editar:
#
#     battctl apply      aplica agora, sem reboot
#     battctl status     mostra o que esta valendo
#     battctl show       lista as chaves com faixa e descricao
#
# Valores fora da faixa aceita pelo driver sao recusados pelo battctl (o
# kernel simplesmente os ignoraria em silencio).

# --- limite de carga (funciona ate no kernel stock) --------------------------
# Para de carregar nesta porcentagem e so recarrega 2% abaixo. 0 desliga.
# Equivale ao "Proteger bateria" da One UI, mas com o valor que voce quiser.
#FULL_CAPACITY=80

# --- exigem o kernel Nethunter r8q v4.3+ (CONFIG_ENG_BATTERY_CONCEPT) --------

# Tensao de fim de carga, em mV (4001..4400). O stock trabalha em 4400.
# 4200 tira ~10% de capacidade util e reduz bastante o estresse da celula.
# Combina com FULL_CAPACITY: um limita por SoC, o outro por tensao.
#FLOAT_VOLTAGE=4200

# Corrente de ENTRADA e corrente de CARGA, em mA (0..4000). Valem para todos
# os tipos de cabo menos USB. ATENCAO: mexer nelas liga as flags de teste do
# driver, que DESATIVAM o step charging -- a carga passa a ser corrente
# constante ate a float voltage, sem os degraus da Samsung.
#INPUT_CURRENT=1500
#FAST_CURRENT=1500

# Corrente de corte do "cheio" (1..999 mA).
#TERM_CURRENT_1ST=200
#TERM_CURRENT_2ND=150

# Throttle termico do charger, em decimos de grau (500 = 50.0 C).
#CHG_TEMP_HIGH=500
#CHG_TEMP_REC=470
#CHG_LIMIT_CURRENT=1000

# Bloqueio de carga por temperatura da bateria, em decimos de grau.
#TEMP_HIGH_NORMAL=500
#TEMP_HIGH_REC_NORMAL=460
#TEMP_LOW_NORMAL=0
#TEMP_LOW_REC_NORMAL=50

# Modo loja: mantem a carga oscilando entre 70 e 80%. SO LIGA -- o driver nao
# implementa o desligamento; para sair, comente esta linha e reinicie.
#STORE_MODE=1

# --- throttle, wireless e protecoes (kernel stock ja tem estes) --------------

# SIOP: throttle global de corrente. O framework baixa este nivel com a tela
# ligada ou o aparelho quente; 100 = sem throttle. Com SIOP_LOCK=1 o arquivo
# fica em 0444 depois de aplicado e o framework nao consegue mais baixa-lo --
# carga rapida sempre, ao custo de perder esse freio termico (sobram
# CHG_TEMP_HIGH/CHG_LIMIT_CURRENT). Era o que o antigo service.d/siop.sh fazia.
#SIOP_LEVEL=100
#SIOP_LOCK=1

# Carga sem fio: 0 recusa o carregador indutivo.
#WC_ENABLE=1

# Power share (carregar outro aparelho por inducao) para nesta carga.
#WC_TX_STOP_CAPACITY=30

# Throttle termico da carga sem fio, em decimos de grau.
#WPC_TEMP_HIGH=420
#WPC_TEMP_REC=400

# 1 DESLIGA o swelling mode -- a protecao que corta/reduz a carga em
# temperatura alta ou baixa. Ligar isso e assumir o risco; util so em bancada.
#SKIP_SWELLING=0

# Timer de seguranca: corta a carga se ela demorar demais (protecao contra
# celula com defeito). 1 = ligado, que e o padrao do driver.
#SAFETY_TIMER=1

# 1 para de alimentar o watchdog do charger. So para depuracao.
#WDT_KICK_DISABLE=0

# Ciclos da celula. NAO e cosmetico: define o degrau de age forecast, e com ele
# a float voltage e o "cheio". No r8q os degraus sao 0/300/400/700/1000 ciclos
# -> 4380/4360/4340/4320/4270 mV. Baixar este numero devolve a tensao alta de
# uma celula nova, desfazendo a protecao que o kernel aplica a uma velha.
#BATTERY_CYCLE=1706

# Fixa o degrau de age forecast direto, sem passar pelo calculo por ciclos:
# 0 = celula nova (4380 mV no r8q), 4 = o ultimo degrau. E o caminho honesto
# para quem quer a tensao alta -- BATTERY_CYCLE chega no mesmo lugar mentindo
# a contagem de ciclos, que tambem alimenta o indicador de saude da bateria.
# Aplicado depois do BATTERY_CYCLE, entao vence se os dois estiverem aqui.
# Exige o kernel Nethunter r8q v4.5+ (o atributo nao existe no stock).
# AVISO: a protecao existe por um motivo -- numa celula com 1700 ciclos,
# fixar o degrau 0 e carregar a 4380 mV justamente o que ja esta gasto.
#AGE_STEP=0

# --- comportamento do modulo (nao vao para o sysfs) --------------------------

# Segundos de espera depois do sys.boot_completed antes de aplicar. O framework
# escreve em batt_full_capacity ao restaurar o estado do "Proteger bateria";
# quem escreve por ultimo vence. Default quando ausente: 20.
#BOOT_DELAY_SEC=20

# Se > 0, reaplica FULL_CAPACITY a cada N segundos caso algo o altere (o app
# da One UI faz isso ao ser mexido). 0 ou ausente desliga o watchdog.
#WATCHDOG_SEC=0

# Tudo acima e template comentado: documenta as chaves e as faixas, e nao tem
# efeito nenhum. O que vale e o que estiver na secao abaixo, onde o battctl
# grava (e de onde ele le). Da para editar a secao a mao; depois rode
# "battctl apply". Chave repetida: vale a ultima.

# === Configurado (o battctl escreve daqui para baixo) ===
