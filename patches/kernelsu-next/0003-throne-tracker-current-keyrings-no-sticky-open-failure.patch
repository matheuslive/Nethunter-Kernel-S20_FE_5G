+/*
+ * Cred for track_throne(). It opens files under /data (packages.list and
+ * every base.apk in /data/app), which on fscrypt v1 needs the encryption
+ * keys from the legacy "fscrypt" keyring that userspace reaches through the
+ * session keyring inherited from init. ksu_cred was captured at initcall
+ * time, before that keyring existed, so opening a file whose key was not
+ * set up yet by another process failed (-EKEYREVOKED/-ENOKEY), and the
+ * manager was never found on boot. Take the keyrings of the current task
+ * (callers run in process context: task_work, renameat LSM hook, ksud) and
+ * only identity, caps and SELinux state from ksu_cred. Kernel threads have
+ * no useful keyrings: keep ksu_cred there.
+ */
+static struct cred *ksu_prepare_throne_cred(void)
+{
+	struct cred *cred;
+
+	if (current->flags & PF_KTHREAD)
+		return NULL;
+
+	cred = prepare_creds();
+	if (!cred)
+		return NULL;
+
+	cred->uid = ksu_cred->uid;
+	cred->gid = ksu_cred->gid;
+	cred->suid = ksu_cred->suid;
+	cred->sgid = ksu_cred->sgid;
+	cred->euid = ksu_cred->euid;
+	cred->egid = ksu_cred->egid;
+	cred->fsuid = ksu_cred->fsuid;
+	cred->fsgid = ksu_cred->fsgid;
+	cred->securebits = ksu_cred->securebits;
+	cred->cap_inheritable = ksu_cred->cap_inheritable;
+	cred->cap_permitted = ksu_cred->cap_permitted;
+	cred->cap_effective = ksu_cred->cap_effective;
+	cred->cap_bset = ksu_cred->cap_bset;
+	cred->cap_ambient = ksu_cred->cap_ambient;
+	ksu_cred_copy_selinux(cred, ksu_cred);
+	return cred;
+}
+
